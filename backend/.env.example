# Database
DATABASE_URL=postgresql://user:password@host:port/dbname

# Better Auth Configuration (must match frontend's NEXT_PUBLIC_APP_URL)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-super-secret-key-here-replace-with-random-string

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# LLM Configuration (Supported providers: openrouter, openai, gemini, mistral, groq)
LLM_PROVIDER=mistral
LLM_MODEL=mistral-small-latest

# API Keys (Provide the one corresponding to your chosen LLM_PROVIDER)
MISTRAL_API_KEY=your_mistral_api_key_here
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
