# Database
DATABASE_URL=postgresql://user:password@host:port/dbname

# Better Auth Configuration (must match frontend's NEXT_PUBLIC_APP_URL)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-super-secret-key-here-replace-with-random-string

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# LLM Configuration (Supported providers: openrouter, openai, gemini, mistral, groq, custom)
LLM_PROVIDER=mistral
LLM_MODEL=mistral-small-latest
LLM_API_KEY=your_generic_api_key_here

# Optional: Set this if using a "custom" provider or if you want to override the default URL
# LLM_BASE_URL=https://api.your-custom-endpoint.com/v1

# Security: BYOK Encryption Key (Generate a secure base64 32-byte key: `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`)
ENCRYPTION_KEY=your_secure_fernet_encryption_key_here
